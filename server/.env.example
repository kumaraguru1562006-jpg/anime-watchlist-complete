# Server Port
PORT=5000

# Database Configuration (MongoDB or Local Fallback)
# If MongoDB is not running, AniCart automatically falls back to local JSON storage (server/data/db.json)
MONGODB_URI=mongodb://localhost:27017/anime_watchlist

# JWT Secret for Session Authentication
JWT_SECRET=your_jwt_secret_key_here

# Google OAuth Client ID (Optional: leave blank for demo/guest authentication)
GOOGLE_CLIENT_ID=

# Google Gemini API Key (Required for AniChat AI Chatbot)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# Tavily Real-Time Web Search & Grounding API Key (Optional: for live search grounding)
# Get a key at: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_MCP_URL=
