{
  "name": "AniCart — Anime Watchlist & Airing Hub",
  "short_name": "AniCart",
  "description": "Track anime, view real-time IST airing schedules, and chat with AniChat AI intelligence",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#070913",
  "theme_color": "#070913",
  "orientation": "portrait-primary",
  "categories": ["entertainment", "lifestyle"],
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Weekly Airing (IST)",
      "short_name": "Airing",
      "description": "View live Indian Standard Time airing schedules",
      "url": "/",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Pinned Anime",
      "short_name": "Pinned",
      "description": "View pinned shows and next episode air dates",
      "url": "/?tab=pinned",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "My Watchlist",
      "short_name": "Watchlist",
      "description": "Open your personal anime watchlist",
      "url": "/?tab=watchlist",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ]
